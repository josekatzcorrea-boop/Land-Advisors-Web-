# Copiar a .env en esta carpeta (nunca subir al repo)

# Meta WhatsApp Cloud API — developers.facebook.com → tu app → WhatsApp
META_GRAPH_VERSION=v22.0
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_VERIFY_TOKEN=land-advisors-webhook-2026

# App (opcional, para renovar tokens)
META_APP_ID=
META_APP_SECRET=

# Notificar a José cuando hay lead calificado (CallMeBot — mismo proxy que landing)
LA_NOTIFY_WEBHOOK_URL=
LA_NOTIFY_PHONE=56974533265

# Servidor
PORT=8787
WEBHOOK_PUBLIC_URL=https://tu-dominio.com/whatsapp/webhook
